---
import type { Lang } from '@/i18n/ui'

interface Props {
  scene: 'hello' | 'coffee' | 'notfound' | 'bye'
  lang?: Lang
}
const { scene, lang = 'zh' } = Astro.props
const labels = {
  hello: ['Clawd 挥手欢迎你', 'Clawd waves hello'],
  coffee: ['Clawd 喝杯咖啡，继续开源实践', 'Clawd takes a coffee break'],
  notfound: ['Clawd 也没找到这个页面', 'Clawd cannot find this page either'],
  bye: ['Clawd 挥手道别，谢谢阅读', 'Clawd waves goodbye — thanks for reading'],
}
---

<div class:list={['clawd-mascot', `clawd-${scene}`, 'not-prose']}>
  <img
    data-clawd-image
    tabindex="0"
    draggable="false"
    title={lang === 'en'
      ? 'Drag to move · double-click or press Escape to reset · arrow keys to move'
      : '按住拖动 · 双击或按 Esc 复位 · 方向键移动'}
    data-gif={`/clawd/${scene}.gif`}
    data-still={`/clawd/${scene}.png`}
    alt={labels[scene][lang === 'en' ? 1 : 0]}
    width="288"
    height="288"
    loading={scene === 'hello' || scene === 'notfound' ? 'eager' : 'lazy'}
    decoding="async"
  />
</div>

<script>
  import { installClawdDrag } from '@/lib/clawd-drag.js'
  installClawdDrag()
</script>

<style>
  .clawd-mascot {
    display: none;
  }
  :global(html[data-appearance='paper']) .clawd-mascot {
    display: flex;
    justify-content: center;
    margin: 0.75rem 0;
  }
  img {
    position: relative;
    z-index: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    display: block;
    width: 8rem;
    height: 8rem;
    object-fit: contain;
  }
  img[data-dragging='true'] {
    cursor: grabbing;
    z-index: 80;
  }
  img:focus-visible {
    outline: 2px dashed hsl(var(--primary));
    outline-offset: 4px;
  }
  :global(html[data-appearance='paper']) .clawd-hello {
    position: absolute;
    top: 0;
    right: calc(50% - 8rem);
    margin: 0;
  }
  .clawd-hello img {
    width: 5rem;
    height: 5rem;
  }
  :global(html[data-appearance='paper']) .clawd-coffee {
    position: absolute;
    top: -4.5rem;
    right: 0;
    margin: 0;
  }
  .clawd-coffee img {
    width: 4rem;
    height: 4rem;
  }
  .clawd-notfound img {
    width: 10rem;
    height: 10rem;
  }
</style>
