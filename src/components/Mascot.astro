---
import type { Lang } from '@/i18n/ui'
import {
  clawdAssetFor,
  clawdSceneLabels,
  eagerClawdScenes,
  type ClawdScene,
} from '@/lib/clawd-scenes'

interface Props {
  scene: ClawdScene
  lang?: Lang
  class?: string
  /** Decorative copies (e.g. the copy bubble) stay out of the tab order. */
  focusable?: boolean
}
const { scene, lang = 'zh', class: className, focusable = true } = Astro.props
const asset = clawdAssetFor(scene)
const label = clawdSceneLabels[scene][lang === 'en' ? 1 : 0]
---

<div
  class:list={['clawd-mascot', `clawd-${scene}`, 'not-prose', className]}
  data-clawd-scene={scene}
>
  <img
    data-clawd-image
    tabindex={focusable ? '0' : '-1'}
    draggable="false"
    title={lang === 'en'
      ? 'Drag to move · double-click or press Escape to reset · arrow keys to move'
      : '按住拖动 · 双击或按 Esc 复位 · 方向键移动'}
    data-gif={`/clawd/${asset}.gif`}
    data-still={`/clawd/${asset}.png`}
    alt={label}
    width="288"
    height="288"
    loading={eagerClawdScenes.includes(scene) ? 'eager' : 'lazy'}
    decoding="async"
  />
</div>

<script>
  import { installClawdDrag } from '@/lib/clawd-drag.js'
  installClawdDrag()
</script>

<style>
  .clawd-mascot {
    display: none;
  }
  :global(html[data-appearance='paper']) .clawd-mascot {
    display: flex;
    justify-content: center;
    margin: 0.75rem 0;
  }
  img {
    position: relative;
    z-index: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-drag: none;
    display: block;
    width: 8rem;
    height: 8rem;
    object-fit: contain;
  }
  img[data-dragging='true'] {
    cursor: grabbing;
    z-index: 80;
  }
  img:focus-visible {
    outline: 2px dashed hsl(var(--primary));
    outline-offset: 4px;
  }
  :global(html[data-appearance='paper']) .clawd-hello {
    position: absolute;
    top: 0;
    right: calc(50% - 8rem);
    margin: 0;
  }
  .clawd-hello img {
    width: 5rem;
    height: 5rem;
  }
  :global(html[data-appearance='paper']) .clawd-coffee {
    position: absolute;
    top: -4.5rem;
    right: 0;
    margin: 0;
  }
  .clawd-coffee img {
    width: 4rem;
    height: 4rem;
  }
  .clawd-notfound img {
    width: 10rem;
    height: 10rem;
  }
  /* Search feedback: one small sticker next to the status line. */
  .clawd-search-idle img,
  .clawd-search-thinking img,
  .clawd-search-empty img,
  .clawd-search-error img,
  .clawd-search-success img {
    width: 4.5rem;
    height: 4.5rem;
  }
  :global(html[data-appearance='paper']) .clawd-search-idle,
  :global(html[data-appearance='paper']) .clawd-search-thinking,
  :global(html[data-appearance='paper']) .clawd-search-empty,
  :global(html[data-appearance='paper']) .clawd-search-error,
  :global(html[data-appearance='paper']) .clawd-search-success {
    justify-content: flex-start;
    margin: 0;
  }
  /* Resident scenes on the about, projects and blog list pages. */
  .clawd-about img,
  .clawd-projects img,
  .clawd-blog-list img {
    width: 4.5rem;
    height: 4.5rem;
  }
  :global(html[data-appearance='paper']) .clawd-about,
  :global(html[data-appearance='paper']) .clawd-projects,
  :global(html[data-appearance='paper']) .clawd-blog-list {
    justify-content: flex-end;
    margin: 0;
  }
  /* New resident stickers share the same drag and motion runtime. */
  .clawd-ultrathink img,
  .clawd-works img {
    width: 4.5rem;
    height: 4.5rem;
  }
  .clawd-lgtm img {
    width: 4rem;
    height: 4rem;
  }
  :global(html[data-appearance='paper']) .clawd-ultrathink,
  :global(html[data-appearance='paper']) .clawd-works,
  :global(html[data-appearance='paper']) .clawd-lgtm {
    justify-content: flex-start;
    margin: 0;
  }
  .clawd-copied img {
    width: 3.5rem;
    height: 3.5rem;
  }
  :global(html[data-appearance='paper']) .clawd-copied {
    margin: 0;
  }
</style>
