---
import Mascot from '@/components/Mascot.astro'
import { openSourceProjects } from '@/data/open-source'

interface Props {
  lang?: 'zh' | 'en'
  surface?: 'home' | 'projects'
}
const { lang = 'zh', surface = 'home' } = Astro.props
const en = lang === 'en'
---

<div class="open-source-projects not-prose">
  <Mascot scene="coffee" lang={lang} />
  {
    openSourceProjects.map((project) => (
      <article class="open-source-card">
        <div class="project-heading">
          <span class="project-kicker">
            {en ? 'OPEN SOURCE / CONTRIBUTOR' : '开源实践 / CONTRIBUTOR'}
          </span>
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="project_link_click"
            data-analytics-surface={surface}
            data-analytics-section="open_source"
            data-analytics-project={project.id}
            data-analytics-link-type="github"
            class="repository-link"
            aria-label={`${project.name} GitHub`}
          >
            GitHub ↗
          </a>
        </div>
        <h3>
          <a href={project.href} target="_blank" rel="noopener noreferrer">
            {project.name}
          </a>
        </h3>
        <p class="project-summary">
          {en ? project.descriptionEn : project.description}
        </p>
        <div class="contribution-detail">
          <p class="contribution-label">
            {en ? 'MY CONTRIBUTIONS' : '我参与的工作'}
          </p>
          <p>{en ? project.contributionEn : project.contribution}</p>
          <ul>
            {project.contributions.map((pr) => (
              <li>
                <a
                  href={pr.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics-event="project_link_click"
                  data-analytics-surface={surface}
                  data-analytics-section="open_source"
                  data-analytics-project={project.id}
                  data-analytics-link-type="pull_request"
                >
                  <span class="pr-number">#{pr.number}</span>
                  <span>{en ? pr.titleEn : pr.title}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          <small>
            {en
              ? 'Submitted contributions · Live review and merge status on GitHub'
              : '已提交的贡献 · 最新评审、合并状态以 GitHub 为准'}
          </small>
        </div>
        <div class="project-tags">
          {project.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </article>
    ))
  }
</div>

<style>
  .open-source-projects {
    position: relative;
    width: 100%;
    min-width: 0;
  }
  .open-source-card {
    padding: 1.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.85rem;
    background: hsl(var(--card));
  }
  .project-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .project-kicker {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
  }
  .repository-link {
    font-size: 0.7rem;
    white-space: nowrap;
  }
  h3 {
    margin: 1rem 0 0.6rem;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: hsl(var(--primary));
  }
  a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
    border-radius: 3px;
  }
  p {
    margin: 0;
    line-height: 1.85;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
  }
  .contribution-detail {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  .contribution-label {
    font-family: system-ui, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: hsl(var(--primary));
    margin-bottom: 0.4rem;
  }
  ul {
    list-style: none;
    margin: 0.85rem 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  li a {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  li a span:nth-child(2) {
    flex: 1;
  }
  .pr-number {
    color: hsl(var(--muted-foreground));
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
  }
  small {
    display: block;
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }
  .project-tags span {
    padding: 0.2rem 0.5rem;
    background: hsl(var(--muted));
    border-radius: 0.3rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
  }
  /* Card-local defaults are the only additions visible in original mode. */
  .open-source-projects {
    display: grid;
    gap: 1rem;
  }
  .open-source-card {
    min-width: 0;
  }
  .project-summary,
  .contribution-detail p,
  li a span:nth-child(2) {
    overflow-wrap: anywhere;
  }
  .repository-link,
  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .repository-link {
    min-width: 44px;
    justify-content: center;
  }
  li a {
    min-height: 44px;
    padding: 0.5rem 0.625rem;
    margin-inline: -0.625rem;
    border-radius: 0.4rem;
  }
  li a span:nth-child(2) {
    min-width: 0;
  }
  li a span:last-child {
    color: hsl(var(--muted-foreground));
  }
  .pr-number {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  li a:hover {
    background: hsl(var(--muted));
  }

  :global(html[data-appearance='paper']) .open-source-card {
    padding: clamp(1.125rem, 3vw, 1.875rem);
    background: hsl(var(--background));
    border-radius: 0.75rem;
    box-shadow:
      0 2px 3px hsl(var(--foreground) / 0.025),
      0 8px 24px hsl(var(--foreground) / 0.035);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }
  :global(html[data-appearance='paper']) .open-source-card:focus-within {
    border-color: hsl(var(--primary) / 0.55);
  }
  :global(html[data-appearance='paper']) h3 {
    margin: 0.5rem 0 0.625rem;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: 500;
  }
  :global(html[data-appearance='paper']) .project-summary {
    font-size: 0.9375rem;
    color: hsl(var(--foreground));
  }
  :global(html[data-appearance='paper']) .contribution-detail {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
  }
  :global(html[data-appearance='paper'])
    .contribution-detail
    > p:not(.contribution-label) {
    font-size: 0.875rem;
  }
  :global(html[data-appearance='paper']) .project-kicker {
    font-size: 0.625rem;
    letter-spacing: 0.09em;
  }
  :global(html[data-appearance='paper']) .repository-link {
    padding-inline: 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
  }
  :global(html[data-appearance='paper']) .repository-link:hover {
    background: hsl(var(--muted));
  }
  :global(html[data-appearance='paper']) ul {
    gap: 0.25rem;
    margin-block: 0.75rem 1rem;
  }
  :global(html[data-appearance='paper']) li a {
    font-size: 0.8125rem;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  :global(html[data-appearance='paper']) li a:active {
    background: hsl(var(--primary) / 0.1);
  }
  :global(html[data-appearance='paper']) small {
    font-size: 0.6875rem;
  }
  :global(html[data-appearance='paper']) .project-tags {
    margin-top: 1.375rem;
    gap: 0.5rem;
  }
  :global(html[data-appearance='paper']) .project-tags span {
    background: hsl(var(--muted) / 0.65);
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html[data-appearance='paper']) .open-source-card:hover {
      border-color: hsl(var(--primary) / 0.4);
      box-shadow:
        0 3px 6px hsl(var(--foreground) / 0.03),
        0 12px 28px hsl(var(--foreground) / 0.055);
    }
  }
  @media (max-width: 400px) {
    .open-source-card {
      padding: 1rem;
    }
    .project-kicker {
      font-size: 0.54rem;
      letter-spacing: 0.04em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .open-source-card,
    .open-source-card a {
      transition: none !important;
    }
  }
</style>
