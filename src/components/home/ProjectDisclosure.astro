---
interface Props {
  lang?: 'zh' | 'en'
}
const { lang = 'zh' } = Astro.props
const en = lang === 'en'
const id = `project-glass-${lang}`
---

<div class="project-glass">
  <button
    class="project-preview"
    type="button"
    data-project-open
    aria-haspopup="dialog"
    aria-controls={id}
  >
    <span class="preview-symbol" aria-hidden="true">S</span>
    <span class="preview-copy">
      <span class="preview-kicker">OPEN SOURCE / CONTRIBUTOR</span>
      <strong>Apache ShenYu</strong>
      <span class="preview-note"
        >{
          en
            ? 'API gateway · Explore my contributions'
            : 'API 网关 · 点击查看我的贡献'
        }</span
      >
    </span>
    <span class="preview-expand" aria-hidden="true">↗</span>
  </button>
  <dialog id={id} class="glass-dialog" aria-labelledby={`${id}-title`}>
    <div class="glass-shell">
      <div class="glass-heading">
        <div>
          <span class="preview-kicker">OPEN SOURCE</span><h2 id={`${id}-title`}>
            {en ? 'Building in the open.' : '在开源中，持续构建。'}
          </h2>
        </div>
        <button
          type="button"
          data-project-close
          class="glass-close"
          aria-label={en ? 'Close project details' : '关闭项目详情'}>×</button
        >
      </div>
      <div class="glass-content"><slot /></div>
      <p class="glass-hint">
        {en ? 'Click outside or press Esc to close' : '点击外部或按 Esc 关闭'}
      </p>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.project-glass').forEach((root) => {
    if (root.dataset.ready) return
    root.dataset.ready = 'true'
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!
    const opener = root.querySelector<HTMLButtonElement>('[data-project-open]')!
    let previousOverflow = ''
    let backdropDown = false
    opener.addEventListener('click', () => {
      previousOverflow = document.documentElement.style.overflow
      dialog.showModal()
      document.documentElement.style.overflow = 'hidden'
      dialog.removeAttribute('data-clawd-inactive')
    })
    root
      .querySelector('[data-project-close]')
      ?.addEventListener('click', () => dialog.close())
    const outside = (event: PointerEvent | MouseEvent) => {
      const box = dialog.getBoundingClientRect()
      return (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      )
    }
    dialog.addEventListener('pointerdown', (event) => {
      backdropDown = outside(event)
    })
    dialog.addEventListener('click', (event) => {
      if (backdropDown && outside(event)) dialog.close()
      backdropDown = false
    })
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow
      dialog.setAttribute('data-clawd-inactive', '')
      opener.focus({ preventScroll: true })
    })
    dialog.setAttribute('data-clawd-inactive', '')
  })
</script>

<style>
  .project-glass {
    width: 100%;
    min-width: 0;
  }
  .project-preview {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: start;
    padding: 1.4rem;
    border-radius: 1.2rem;
    border: 1px solid hsl(var(--border) / 0.7);
    background: linear-gradient(
      125deg,
      hsl(var(--background) / 0.85),
      hsl(var(--muted) / 0.55)
    );
    backdrop-filter: blur(18px);
    box-shadow:
      inset 0 1px 0 hsl(var(--foreground) / 0.04),
      0 8px 28px hsl(var(--foreground) / 0.04);
    cursor: pointer;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
    color: hsl(var(--foreground));
  }
  .project-preview:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--primary) / 0.45);
    box-shadow: 0 14px 36px hsl(var(--foreground) / 0.09);
  }
  .preview-symbol {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 0.9rem;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.09);
    font:
      italic 1.8rem Georgia,
      serif;
  }
  .preview-copy {
    display: grid;
    gap: 0.4rem;
  }
  .preview-kicker {
    font-family: system-ui, sans-serif;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
  }
  strong {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .preview-note {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }
  .preview-expand {
    margin-left: auto;
    font-size: 1.35rem;
    color: hsl(var(--primary));
  }
  .glass-dialog {
    padding: 0;
    width: min(680px, calc(100vw - 32px));
    max-height: min(88dvh, 900px);
    margin: auto;
    border: 1px solid hsl(var(--foreground) / 0.15);
    border-radius: 1.6rem;
    color: hsl(var(--foreground));
    background: hsl(var(--background) / 0.82);
    backdrop-filter: blur(30px) saturate(135%);
    -webkit-backdrop-filter: blur(30px) saturate(135%);
    box-shadow:
      0 30px 100px #0004,
      inset 0 1px 0 #ffffff40;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .glass-dialog::backdrop {
    background: #14131855;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .glass-dialog[open] {
    animation: glass-arrive 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .glass-shell {
    padding: clamp(1.2rem, 4vw, 2rem);
  }
  .glass-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }
  .glass-heading h2 {
    font-size: 1.5rem;
    margin-top: 0.5rem;
    line-height: 1.5;
  }
  .glass-close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    font-size: 1.5rem;
    background: hsl(var(--background) / 0.55);
    cursor: pointer;
  }
  .glass-close:hover {
    background: hsl(var(--muted));
  }
  .glass-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  :global(html[data-appearance='paper']) .glass-content {
    padding-top: 3rem;
  }
  .glass-content :global(.open-source-card) {
    background: hsl(var(--background) / 0.35);
    border-color: hsl(var(--foreground) / 0.1);
  }
  .glass-hint {
    text-align: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    margin: 1.5rem 0 0;
  }
  button:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  @keyframes glass-arrive {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-preview {
      transition: none;
    }
    .glass-dialog[open] {
      animation: none;
    }
  }
</style>
