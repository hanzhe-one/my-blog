---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'contributions', text: 'Contributions' },
  { depth: 2, slug: 'theme', text: 'Theme' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>如果你觉得合作一个项目会有趣或有意义，你可以通过捐赠支持我的工作，或者联系我一起讨论项目。</p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='contributions'>Contributions</h2>
  <p class='text-muted-foreground'>我在 GitHub 上的公开贡献热力图。</p>
  <GitHubContributions username='hanzhe-one' />

  <h2 id='theme'>Theme</h2>
  <p class='text-muted-foreground'>
    本站基于 <a href='https://github.com/cworld1/astro-theme-pure' target='_blank' class='text-primary hover:underline'>🍭 Astro-theme-pure</a>
    构建 —— 一个简洁而强大的 Astro 博客主题。
  </p>

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>Please leave a message or contact me proactively after sponsorship.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat, methodName: 'wechat_pay' },
      { name: 'Alipay', icon: 'alipay', image: alipay, methodName: 'alipay' }
    ]}
  />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
