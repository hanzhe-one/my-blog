---
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'get-in-touch', text: 'Get in Touch' }
]
---

<PageLayout title='Contact' {headings}>
  <h2 id='get-in-touch'>Get in Touch</h2>
  <p>Have a question or want to work together? Drop me a message!</p>

  <form action="https://formspree.io/f/your-form-id" method="POST" class="not-prose flex flex-col gap-y-4">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="w-full rounded-lg border bg-background px-4 py-2 outline-none focus:border-[#659EB9]"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="w-full rounded-lg border bg-background px-4 py-2 outline-none focus:border-[#659EB9]"
      />
    </div>
    <div>
      <label for="message" class="mb-1 block text-sm font-medium">Message</label>
      <textarea
        id="message"
        name="message"
        rows={5}
        required
        class="w-full rounded-lg border bg-background px-4 py-2 outline-none focus:border-[#659EB9]"
      />
    </div>
    <button
      type="submit"
      class="w-fit rounded-lg bg-[#659EB9] px-6 py-2 text-white transition-opacity hover:opacity-90"
    >
      Send Message
    </button>
  </form>
</PageLayout>
